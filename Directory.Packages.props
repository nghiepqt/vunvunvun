<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Version policy (see agent-docs/CONTEXT.md section 5):
    - .NET 10 is LTS. Do not move to a .NET 11 preview package band.
    - Microsoft.Data.Sqlite stays on the 10.x band; 11.x is preview only.
    - sqlite-vec is pre-1.0 and MUST be pinned to an exact version (added in phase 01).
  -->
  <ItemGroup Label="Windows App SDK / UI">
    <!--
      The Microsoft.WindowsAppSDK meta-package also pulls .ML, .AI, .Search and .Widgets.
      .ML brings Microsoft.Windows.AI.MachineLearning, which ships its own onnxruntime.dll
      and collides in the MSIX payload with the DirectML build that CONTEXT section 5 fixes
      as the ONNX inference stack (APPX1101). None of those four components are in the
      product, so the SDK is composed from the components that are. .ML is reachable only
      from the meta-package, so this keeps it out of the graph entirely.

      Microsoft.WindowsAppSDK.Runtime validates that every referenced component matches the
      version it expects, so these versions must stay exactly as Microsoft.WindowsAppSDK 2.4.0
      declares them. Bump them together, as a set, when moving to a new SDK release.
    -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.4.0" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.1" />
  </ItemGroup>

  <ItemGroup Label="MVVM">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="Interop">
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.321" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <!-- SQLitePCLRaw 2.1.13 is the version aligned with Microsoft.Data.Sqlite 10.0.11,
         which declares a dependency on SQLitePCLRaw.core 2.1.12. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup Label="ML">
    <!-- Microsoft.ML.OnnxRuntime.DirectML supersedes and must not be combined with
         the base Microsoft.ML.OnnxRuntime package. RIDs: win-x64, win-x86, win-arm64. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

</Project>
