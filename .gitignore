# MSIX / AppPackages
# NOTE: do not ignore *.pubxml. EfAssistant.App references
# Properties\PublishProfiles\win-$(Platform).pubxml, so publish profiles are
# source and must be tracked.
AppPackages/
BundleArtifacts/
publish/
PublishScripts/
Package.StoreAssociation.xml
_pkginfo.txt
*.msix
*.msixbundle
*.appx
*.appxbundle
*.msixupload
*.appxupload

# Code-signing material. Must never be committed.
*.pfx
*.p12
*.cer
*.snk

# NuGet
*.nupkg
*.snupkg
project.lock.json

# Local secrets
appsettings.*.local.json
secrets.json

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Local SQLite databases created during development
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Native binaries and model artifacts (acquired out of band, not committed)
native/llama-server/*.exe
native/llama-server/*.dll
resources/onnx/*.onnx
resources/onnx/*.bin
*.gguf
