<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EfAssistant.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" />
  </ItemGroup>

  <!--
    App depends on everything; nothing depends on App. EfAssistant.Gateway is a
    separately deployed ASP.NET Core service and is deliberately not referenced.
  -->
  <ItemGroup>
    <ProjectReference Include="..\EfAssistant.Core\EfAssistant.Core.csproj" />
    <ProjectReference Include="..\EfAssistant.Data\EfAssistant.Data.csproj" />
    <ProjectReference Include="..\EfAssistant.Ai\EfAssistant.Ai.csproj" />
    <ProjectReference Include="..\EfAssistant.Ml\EfAssistant.Ml.csproj" />
    <ProjectReference Include="..\EfAssistant.Activity\EfAssistant.Activity.csproj" />
    <ProjectReference Include="..\EfAssistant.Sync\EfAssistant.Sync.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    MSIX symbol package generation needs mspdbcmf.exe from the MSVC toolset. The packaging
    targets locate it through $(VCToolsInstallDir) or $(VsInstallRoot), both of which are set
    only inside a Developer Command Prompt. Under a plain `dotnet build` neither is set, so
    the build warns and silently skips the .appxsym. Resolve the install root with vswhere
    so packaging behaves the same locally and on a CI runner.
  -->
  <Target Name="ResolveVsInstallRootForSymbolPackaging"
          BeforeTargets="_EnsurePdbCmfExeFullPath"
          Condition="'$(VCToolsInstallDir)' == '' and '$(VsInstallRoot)' == '' and '$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <_VsWhereExe>$([System.Environment]::GetFolderPath(SpecialFolder.ProgramFilesX86))\Microsoft Visual Studio\Installer\vswhere.exe</_VsWhereExe>
    </PropertyGroup>
    <Exec Command="&quot;$(_VsWhereExe)&quot; -latest -products * -property installationPath"
          Condition="Exists('$(_VsWhereExe)')"
          ConsoleToMsBuild="true"
          StandardOutputImportance="low"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ResolvedVsInstallRoot" />
    </Exec>
    <PropertyGroup Condition="'$(_ResolvedVsInstallRoot)' != ''">
      <VsInstallRoot>$(_ResolvedVsInstallRoot.Trim())</VsInstallRoot>
    </PropertyGroup>
  </Target>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!--
      Trimming stays off. WinUI resolves XAML types reflectively, so a trimmed build
      fails at runtime, and Microsoft.Windows.SDK.NET and WinRT.Runtime emit IL2104
      trim warnings that TreatWarningsAsErrors (Directory.Build.props) turns into
      NETSDK1144, breaking every Release build.
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
