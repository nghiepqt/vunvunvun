<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EfAssistant.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- WinUI 3 does not support AnyCPU. -->
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Program.cs owns the entry point. Without this the XAML compiler also emits a
         Program.Main into App.g.i.cs and the build fails with CS0017. A hand-written
         Main is required from phase 02 onward for single-instance and tray startup. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Phase 00 item 2 also calls for a self-contained unpackaged build for the
         direct-download channel. Produce it with:
           dotnet publish -c Release -r win-x64 -p:WindowsPackageType=None -p:WindowsAppSDKSelfContained=true -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" />
  </ItemGroup>

  <!-- App depends on everything; nothing depends on App. Gateway is a separately
       deployed service and is deliberately not referenced. -->
  <ItemGroup>
    <ProjectReference Include="..\EfAssistant.Core\EfAssistant.Core.csproj" />
    <ProjectReference Include="..\EfAssistant.Data\EfAssistant.Data.csproj" />
    <ProjectReference Include="..\EfAssistant.Ai\EfAssistant.Ai.csproj" />
    <ProjectReference Include="..\EfAssistant.Ml\EfAssistant.Ml.csproj" />
    <ProjectReference Include="..\EfAssistant.Activity\EfAssistant.Activity.csproj" />
    <ProjectReference Include="..\EfAssistant.Sync\EfAssistant.Sync.csproj" />
  </ItemGroup>

</Project>
