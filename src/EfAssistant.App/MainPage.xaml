<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EfAssistant.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EfAssistant.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Accessibility is a Definition of Done line on every UI ticket (CONTEXT 4.1),
        not a later polish pass: every interactive element carries an accessible name,
        and icon-only controls convey nothing to a screen reader without one.
        Names come from Strings\en-US\Resources.resw via x:Uid so that all user-facing
        copy sits in the one catalog the banned-vocabulary check reads.
    -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
            Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <Button x:Uid="IncrementButton" Command="{x:Bind ViewModel.IncrementCommand}">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
            </Button>
            <TextBlock
                x:Uid="CountText"
                AutomationProperties.LiveSetting="Polite"
                Text="{x:Bind ViewModel.Counter, Mode=OneWay}"
                VerticalAlignment="Center"
                MinWidth="40"
                TextAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button x:Uid="DecrementButton" Command="{x:Bind ViewModel.DecrementCommand}">
                <FontIcon Glyph="&#xE738;" FontSize="14" />
            </Button>
        </StackPanel>
    </StackPanel>
</Page>
