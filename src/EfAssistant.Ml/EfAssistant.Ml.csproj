<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-targeted because Microsoft.ML.OnnxRuntime.DirectML ships native assets
         for win-x64 / win-x86 / win-arm64 only. A plain net10.0 TFM resolves those
         assets unpredictably and gives no platform guard. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>EfAssistant.Ml</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EfAssistant.Core\EfAssistant.Core.csproj" />
  </ItemGroup>

</Project>
